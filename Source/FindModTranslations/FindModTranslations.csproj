<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>FindModTranslations</AssemblyName>
    <RootNamespace>FindModTranslations</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <OutputPath>../../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldRoot>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RimWorldRoot)\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == '' And Exists('..\..\References\0Harmony.dll')">..\..\References\0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
    <AssemblyCSharpDll Condition="'$(AssemblyCSharpDll)' == '' And Exists('..\..\References\Assembly-CSharp.dll')">..\..\References\Assembly-CSharp.dll</AssemblyCSharpDll>
    <AssemblyCSharpDll Condition="'$(AssemblyCSharpDll)' == ''">$(RimWorldManagedDir)\Assembly-CSharp.dll</AssemblyCSharpDll>
    <UnityEngineDir Condition="'$(UnityEngineDir)' == '' And Exists('..\..\References\UnityEngine.CoreModule.dll')">..\..\References</UnityEngineDir>
    <UnityEngineDir Condition="'$(UnityEngineDir)' == ''">$(RimWorldManagedDir)</UnityEngineDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(AssemblyCSharpDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityEngineDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(UnityEngineDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(UnityEngineDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(UnityEngineDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
